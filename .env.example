CHIRP_SECRET_KEY=change-me-in-production
CHIRP_ENV=development
CHIRP_DEBUG=1
# Optional: pin Ed25519 private keys (32-byte hex) for stable signing across restarts.
# ORRERY_GAZE_PRIVATE_KEY=
# ORRERY_RESOLVE_PRIVATE_KEY=
# ORRERY_PDF_PRIVATE_KEY=
# ORRERY_PDF_KEY_ID=orrery-pdf-1
# ORRERY_WORLD_TIME_PRIVATE_KEY=
# ORRERY_WORLD_TIME_KEY_ID=orrery-world-time-1
# Deterministic world-time fixture for tests/CI (JSON object). Leave unset for live API.
# ORRERY_WORLD_TIME_JSON={"dateTime":"2026-01-01T00:00:00","date":"01/01/2026","time":"00:00","timeZone":"UTC","dayOfWeek":"Thursday"}
# Deterministic source-watch fixtures for tests/CI (JSON object keyed by source id).
# Leave unset for live official-source fetches.
# ORRERY_SOURCE_WATCH_FIXTURES={"python-release-notes":"<html><body><h1>Python 3.14.0</h1></body></html>"}
# Skip boot-time freeze+smoke when iterating locally:
# ORRERY_SKIP_PUBLISH=1
